pkgname=clipboardwire
pkgver=0.4.6
pkgrel=1
pkgdesc="Clipboard-sync hub and client over WebSocket"
arch=('x86_64')
url="https://github.com/davefx/clipboardwire"
license=('GPL-3.0-or-later')
depends=('libappindicator')  # Ajoute d'autres dépendances natives si besoin
source=("clipboardwire-linux-x86_64::https://github.com/davefx/clipboardwire/releases/download/v$pkgver/clipboardwire-linux-x86_64"
        "clipboardwire.service::https://raw.githubusercontent.com/davefx/clipboardwire/v$pkgver/packaging/systemd/clipboardwire.service"
        "clipboardwire.env.example::https://raw.githubusercontent.com/davefx/clipboardwire/v$pkgver/packaging/clipboardwire.env.example"
        "LICENSE::$url/raw/v$pkgver/LICENSE"
        "README.md::$url/raw/v$pkgver/README.md"
        "PROTOCOL.md::$url/raw/v$pkgver/PROTOCOL.md"
)
sha256sums=('SKIP') # Mets les checksums réels si tu veux

package() {
    install -Dm755 "$srcdir/clipboardwire-linux-x86_64" "$pkgdir/usr/bin/clipboardwire"
    install -Dm644 "$srcdir/clipboardwire.service" "$pkgdir/usr/lib/systemd/system/clipboardwire.service"
    install -Dm644 "$srcdir/clipboardwire.env.example" "$pkgdir/etc/clipboardwire/clipboardwire.env.example"
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$srcdir/PROTOCOL.md" "$pkgdir/usr/share/doc/$pkgname/PROTOCOL.md"
}
